# MongoDB Ops Manager SDK generator configuration.
# Copy this file to .env and adjust the values as needed.
# Every variable is optional: the values below are the built-in defaults.
# Exported environment variables take precedence over this file.

# SITEMAP_URL and API_BASE_URL default to the documentation version derived from
# the [project] version in pyproject.toml, as v{major}.{minor} (currently v8.0).
# Uncomment them only to point the generator at another documentation version.
#
# XML sitemap used to discover the API documentation pages.
# SITEMAP_URL=https://www.mongodb.com/docs/ops-manager/v8.0/sitemap-0.xml

# Only sitemap entries starting with this prefix are treated as API documents.
# API_BASE_URL=https://www.mongodb.com/docs/ops-manager/v8.0/reference/api/

# Directory holding api_docs.json and normalized_api_docs.json.
# Relative paths are resolved from the current working directory.
HOME_DIR=.data

# Number of days after which a crawled API document expires and gets recrawled.
EXPIRE_DAYS=7
